# GEMINI_API_KEY: Required for Gemini AI API calls (document OCR & bank receipt verification).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Dashboard Credentials (configure via Settings > Secrets before deploying)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional Korean Bank Transfer & Telegram Auto-Unlock Bot integration
KR_BANK_NAME=
KR_BANK_ACCOUNT=
KR_BANK_HOLDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Optional comma-separated campaign redeem codes
REDEEM_CODES=

# Optional Google Sheets Redeem Code reader/sync
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB="RedeemCodes"
GOOGLE_SHEETS_API_KEY=

