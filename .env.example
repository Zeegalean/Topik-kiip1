# GEMINI_API_KEY: Required for Gemini AI API calls (document OCR & bank receipt verification).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Dashboard Credentials (configure via Settings > Secrets before deploying)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional ABA PayWay Merchant API credentials (for automated 15-min QR verification)
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_LINK_URL="https://link.payway.com.kh/ABAPAYzz552103m"

# Optional Korean Bank Transfer & Telegram Auto-Unlock Bot integration
KR_BANK_NAME=
KR_BANK_ACCOUNT=
KR_BANK_HOLDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Optional Zoho Mail SMTP (for automated PDF receipt emails)
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=

# Optional comma-separated campaign redeem codes
REDEEM_CODES=
