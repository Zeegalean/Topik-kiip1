rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'zeekhmerads@gmail.com' || 
         (resource != null && resource.data.role == 'admin') ||
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    match /documents/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /payments/{payId} {
      allow read, write: if isAuthenticated();
    }

    match /promoCodes/{codeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /centers/{centerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
